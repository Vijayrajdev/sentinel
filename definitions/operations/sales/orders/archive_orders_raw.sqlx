config {
  type: "operations",
  tags: ["sales", "orders", "archive"],
  description: "Idempotent archival operations moving processed orders records to history.",
  dependencies: ["fct_orders"]
}

INSERT INTO `sentinel-486707.sentinel_raw.orders_raw_hist` (
  order_id,
  customer_name,
  amount,
  status,
  category,
  order_date,
  warehouse_id,
  product_id,
  email,
  batch_date,
  processed_dttm
)
SELECT
  order_id,
  customer_name,
  amount,
  status,
  category,
  order_date,
  warehouse_id,
  product_id,
  email,
  CURRENT_DATE() AS batch_date,
  SAFE_CAST(processed_dttm AS TIMESTAMP) AS processed_dttm
FROM ${ref("orders_raw")};

TRUNCATE TABLE ${ref("orders_raw")};