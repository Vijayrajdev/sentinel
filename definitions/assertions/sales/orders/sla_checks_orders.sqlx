config {
  type: "assertion",
  tags: ["sales", "orders", "sla"],
  description: "Validates freshness and completeness SLAs as defined in the Data Contract."
}

SELECT
  'Freshness Breach: Data older than 24h' AS failure_reason,
  MAX(processed_dttm) AS last_processed_at
FROM ${ref("fct_orders")}
HAVING MAX(processed_dttm) < TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 24 HOUR)

UNION ALL

SELECT
  'Completeness Breach: Ingestion success rate below 98%' AS failure_reason,
  NULL AS last_processed_at
FROM (
  SELECT
    SAFE_DIVIDE(
      (SELECT COUNT(*) FROM ${ref("fct_orders")} WHERE batch_date = CURRENT_DATE()),
      (SELECT COUNT(*) FROM `sentinel-486707.sentinel_raw.orders_raw_hist` WHERE batch_date = CURRENT_DATE())
    ) AS success_rate
)
WHERE success_rate < 0.98