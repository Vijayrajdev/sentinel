config {
  type: "assertion",
  tags: ["sales", "orders", "sla"],
  description: "Validates freshness and completeness SLAs as defined in the Data Contract."
}

SELECT
  'Freshness Breach: Max processed_dttm is older than 24 hours' AS failure_reason,
  MAX(processed_dttm) AS last_processed_at
FROM ${ref("fct_orders")}
HAVING MAX(processed_dttm) < TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 24 HOUR)

UNION ALL

SELECT
  'Completeness Breach: Success rate below 98%' AS failure_reason,
  NULL AS last_processed_at
FROM (
  SELECT
    (SELECT COUNT(*) FROM ${ref("fct_orders")}) / 
    NULLIF((SELECT COUNT(*) FROM `sentinel-486707.sentinel_raw.orders_raw_hist` WHERE batch_date = CURRENT_DATE()), 0) AS success_rate
)
WHERE success_rate < 0.98